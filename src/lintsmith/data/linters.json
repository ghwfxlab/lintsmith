      "apk": [
        "rust-clippy",
        "rustfmt"
      ],
      "baseline": "standard",
      "check": [
        "cargo clippy --version"
      ]
    },
    "SCALAFMT": {
      "bins": [
        "/usr/bin/scalafmt"
      ],
      "apk": [
        "openjdk21-jre",
        "gcompat"
      ],
      "check": [
        "scalafmt --version"
      ]
    },
    "SHELL_SHFMT": {
      "bins": [
        "/usr/bin/shfmt"
      ],
      "check": [
        "shfmt --version"
      ]
    },
    "SNAKEMAKE_LINT": {
      "venvs": [
        "snakemake"
      ],
      "check": [
        "snakemake --version"
      ]
    },
    "SNAKEMAKE_SNAKEFMT": {
      "venvs": [
        "snakefmt"
      ],
      "check": [
        "snakefmt --version"
      ]
    },
    "SPELL_CODESPELL": {
      "venvs": [
        "codespell"
      ],
      "check": [
        "codespell --version"
      ]
    },
    "SQLFLUFF": {
      "venvs": [
        "sqlfluff"
      ],
      "check": [
        "sqlfluff --version"
      ]
    },
    "STATES": {
      "npm": [
        "asl"
      ],
      "check": [
        "asl-validator --help"
      ]
    },
    "TERRAFORM_FMT": {
      "bins": [
        "/usr/bin/terraform"
      ],
      "check": [
        "terraform version"
      ]
    },
    "TERRAFORM_TFLINT": {
      "bins": [
        "/usr/bin/tflint"
      ],
      "dirs": [
        "/root/.tflint.d"
      ],
      "env": {
        "TFLINT_PLUGIN_DIR": "/root/.tflint.d/plugins"
      },
      "check": [
        "tflint --version"
      ]
    },
    "TERRAGRUNT": {
      "bins": [
        "/usr/bin/terragrunt"
      ],
      "check": [
        "terragrunt --version"
      ]
    },
    "TRIVY": {
      "bins": [
        "/usr/bin/trivy"
      ],
      "dirs": [
        "/contrib"
      ],
      "check": [
        "trivy --version"
      ]
    },
    "TSX": {
      "npm": [
        "eslint",
        "eslint_react"
      ],
      "check": [
        "eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.ts"
      ]
    },
    "TYPESCRIPT_ES": {
      "npm": [
        "eslint"
      ],
      "check": [
        "eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.ts"
      ]
    },
    "TYPESCRIPT_PRETTIER": {
      "npm": [
        "prettier"
      ],
      "check": [
        "prettier --check /tmp/fx/t.ts"
      ]
    },
    "VUE": {
      "npm": [
        "eslint"
      ],
      "check": [
        "eslint -c /action/lib/.automation/eslint.config.mjs /tmp/fx/t.js"
      ]
    },
    "VUE_PRETTIER": {
      "npm": [
        "prettier"
      ],
      "check": [
        "prettier --version"
      ]
    },
    "XML": {
      "check": [
        "xmllint --version"
      ]
    },
    "YAML": {
      "venvs": [
        "yamllint"
      ],
      "check": [
        "yamllint -c /action/lib/.automation/.yaml-lint.yml /tmp/fx/t.yml"
      ]
    },
    "YAML_PRETTIER": {
      "npm": [
        "prettier"
      ],
      "check": [
        "prettier --check /tmp/fx/t.yml"
      ]
    }
  }
}
